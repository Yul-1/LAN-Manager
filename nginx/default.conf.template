# LANMng — reverse proxy LAN-only.
# nginx gira in network_mode host: raggiunge il backend su 127.0.0.1:8000
# (uvicorn e' in ascolto solo su loopback, non esposto direttamente in LAN).
#
# E' un TEMPLATE: l'entrypoint dell'immagine nginx lo espande con envsubst in
# /etc/nginx/conf.d/default.conf all'avvio. L'unica variabile sostituita e'
# LANMNG_HTTP_PORT (NGINX_ENVSUBST_FILTER nel Dockerfile), cosi' le variabili
# di nginx ($host, $http_upgrade...) restano intatte.

upstream lanmng_backend {
    server 127.0.0.1:8000;
}

server {
    # Porta sull'host (network_mode host): con la 80 gia' occupata da un altro
    # servizio nginx non partirebbe affatto, quindi la si sceglie da fuori con
    # LANMNG_HTTP_PORT (vedi .env.example). Default 80.
    listen ${LANMNG_HTTP_PORT};
    server_name _;

    # Gli stessi header del vhost per l'nginx host (deploy/lanmng.nginx.conf):
    # i due scenari di deploy devono comportarsi allo stesso modo.
    server_tokens off;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    # CSP: la SPA usa solo asset locali; consentiti stili inline (attributi style)
    # e WebSocket/fetch same-origin. Secondo livello di difesa contro XSS.
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    # La dashboard non usa nessuna di queste API del browser: negarle riduce
    # cio' che un eventuale script iniettato potrebbe chiedere all'utente.
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), usb=(), payment=()" always;
    # Senza questo il browser applica la cache euristica e dopo un deploy
    # continua a mostrare la UI precedente.
    add_header Cache-Control "no-cache" always;

    # Frontend statico (SPA): fallback su index.html per le route lato client.
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # WebSocket update live: richiede l'upgrade della connessione.
    location /ws {
        proxy_pass http://lanmng_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Il WS resta aperto: niente timeout aggressivi.
        proxy_read_timeout 3600s;
    }

    # API REST e healthcheck.
    location /api/ {
        proxy_pass http://lanmng_backend;
        # $http_host (non $host) conserva la porta: i redirect 307 che FastAPI
        # genera per i path senza slash finale altrimenti la perdono.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Alcune chiamate sono lente per natura: nmap dai tool di rete ha 180s
        # di budget (services/nettools.py), come lo scan dei dispositivi e la
        # raccolta risorse via SSH. Il default di 60s le troncava con un 504 in
        # HTML, che il frontend non poteva nemmeno interpretare. Sta sopra al
        # budget massimo del client, cosi' a scrivere il messaggio d'errore e'
        # LANMng e non una pagina del proxy.
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
        # I tool di rete mandano l'output mentre il comando gira (NDJSON su
        # /api/tools/stream). Non serve spegnere `proxy_buffering` per tutta la
        # location: quella risposta porta `X-Accel-Buffering: no`, che nginx
        # rispetta caso per caso. Senza, il proxy accumulerebbe il corpo e lo
        # consegnerebbe tutto alla fine: lo streaming sarebbe solo apparente.
    }

    location = /health {
        proxy_pass http://lanmng_backend;
        proxy_set_header Host $host;
        access_log off;
    }
}
