# Copia in ".env" accanto al docker-compose che usi sul server.
#
# TAG: versione delle immagini da avviare. Deve combaciare con quella caricata
# via "docker load" (o costruita in locale).
TAG=0.1.0

# DOCKER_GID: gid del gruppo "docker" DELL'HOST. Serve solo a
# deploy/docker-compose.host-nginx.yml, che lo usa come gruppo supplementare
# per far leggere /var/run/docker.sock al container senza girare da root.
# Cambia da host a host: ricavalo con
#   getent group docker | cut -d: -f3
# Senza, quel compose si rifiuta di partire invece di perdere in silenzio il
# monitoraggio Docker.
DOCKER_GID=999
