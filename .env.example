# Copia in ".env" accanto al docker-compose che usi sul server.
#
# TAG: versione delle immagini da avviare. Deve combaciare con quella caricata
# via "docker load" (o costruita in locale).
TAG=0.1.0

# DOCKER_GID: gid del gruppo "docker" DELL'HOST. Entrambi i compose lo usano come
# gruppo supplementare, per far leggere /var/run/docker.sock al container senza
# girare da root. Cambia da host a host: ricavalo con
#   getent group docker | cut -d: -f3
# deploy/docker-compose.host-nginx.yml lo pretende (si rifiuta di partire invece
# di perdere in silenzio il monitoraggio Docker); il docker-compose.yml della
# radice ripiega sul 999 tipico di Debian/Ubuntu, cosi' un clone parte senza .env.
# Se sul tuo host il gid e' un altro, la pagina Servizi resta senza i container
# locali finche' non lo scrivi qui.
DOCKER_GID=999

# LANMNG_HTTP_PORT: porta dell'host su cui la dashboard risponde (solo
# docker-compose.yml della radice, dove nginx gira in network_mode host).
# Cambiala se la 80 e' gia' occupata da un altro servizio: senza, nginx non
# parte affatto ("bind() to 0.0.0.0:80 failed (98: Address in use)").
LANMNG_HTTP_PORT=80
